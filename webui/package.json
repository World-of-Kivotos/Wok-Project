{
  "name": "wok-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "游戏内 Web UI 前端 (MCEF 内嵌 Chromium 渲染, 像素风设计系统)",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-pixel-guards.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify-pixel-guards.mjs",
    "assets:nineslice": "node tools/gen-nineslice.mjs",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "stylelint": "^16.26.0",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
