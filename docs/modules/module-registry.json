  "boundaryExceptions": [
    {"source": "wok-core", "target": "wok-job-core", "reason": "entry capability and the legacy main channel still carry job data", "exit": "move job packets and job progress storage behind module-owned adapters"},
    {"source": "wok-core", "target": "wok-job-agent", "reason": "legacy main channel centrally registers agent packets", "exit": "let the agent module register fixed discriminator IDs through a channel registrar"},
    {"source": "wok-core", "target": "wok-champion", "reason": "legacy main channel centrally registers champion size sync", "exit": "let the champion module register its fixed discriminator ID"},
    {"source": "wok-core", "target": "wok-webui", "reason": "C2S WebUI request packet directly invokes the WebUI dispatcher", "exit": "bind a WebUI request handler into the network boundary"},
    {"source": "wok-core", "target": "wok-job-miner", "reason": "EntryGateway directly imports MinerLevelGate", "exit": "move difficulty gate policy into a shared job contract"},
    {"source": "wok-core", "target": "wok-job-tarot", "reason": "global vulnerability handler reads TarotCombatState directly", "exit": "bind a generic vulnerability-immunity provider"},
    {"source": "wok-core", "target": "wok-marriage", "reason": "central ModItems still constructs marriage ring items", "exit": "move ring DeferredRegister ownership into the marriage module"},
    {"source": "wok-core", "target": "wok-mining", "reason": "legacy registry and entry packages directly reference mining implementations", "exit": "move mining registrations into mining and split player data from entry orchestration"},
    {"source": "wok-job-tarot", "target": "wok-job-miner", "reason": "Hermit shiny effect reuses miner scan and highlight implementations", "exit": "publish an ore-highlight capability from the mining API"},
    {"source": "wok-job-brewer", "target": "wok-job-tarot", "reason": "gin maximum-health cap reads TarotRuntime directly", "exit": "publish a shared maximum-health contribution query through combat core"},
    {"source": "wok-champion", "target": "wok-job-armorer", "reason": "Champion GameTest imports the armorer deterministic random test utility", "scope": "test-only", "exit": "move the deterministic random helper into shared testutil"},
    {"source": "wok-mining", "target": "wok-champion", "reason": "pressure spawning directly calls ChampionSpawnSeam", "exit": "make the spawn promotion seam owned by mining and bind champion into it"},
    {"source": "wok-webui", "target": "wok-case-opening", "reason": "WebUiBridge directly plays and stops CaseSounds", "exit": "register case-local actions through a generic WebUI client action registry"},
    {"source": "wok-case-opening", "target": "wok-app", "reason": "TaCZ export bootstrap uses MiningDim.class as its resource anchor", "exit": "use the case bootstrap class as the same-JAR resource anchor"},
    {"source": "wok-job-munitions", "target": "wok-app", "reason": "TaCZ export bootstrap uses MiningDim.class as its resource anchor", "exit": "use the gunsmith bootstrap class as the same-JAR resource anchor"}
  ]
}
